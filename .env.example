# ============================================================
# YouTube AI Automation Pipeline — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Anthropic (Claude) ---
# Used for: script generation, metadata, thumbnail prompts, shot lists
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- YouTube Data API v3 ---
# Used for: fetching trending videos in the technology category
# Get yours at: https://console.cloud.google.com/ (enable YouTube Data API v3)
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Reddit API ---
# Used for: fetching top posts from tech/AI subreddits
# Get yours at: https://www.reddit.com/prefs/apps (create a "script" app)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=youtube-ai-automation/1.0

# --- Text-to-Speech (ElevenLabs) ---
# Used for: generating Hinglish voiceover audio
# Get yours at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Google Cloud TTS as alternative
# GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# --- Image Generation (optional) ---
# Used for: programmatic thumbnail generation
# Leave blank if generating thumbnails manually
IMAGE_GEN_API_KEY=your_image_gen_api_key_here
